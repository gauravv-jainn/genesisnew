// Genesis Media — Prisma schema
//
// SCOPE: Phase 0 only. Auth, audit trail, and marketing-site form capture.
// The Genesis Workspace tables (clients, projects, invoices, content,
// automations) are deliberately NOT here — see PROGRESS.md §Out of scope.
//
// Datasource URL is configured in `prisma.config.ts` (Prisma 7 convention),
// not inline here.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Roles are mirrored from Auth0 into the local DB so authorization checks
/// never require a network round-trip to Auth0.
enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id          String    @id @default(cuid())
  /// Auth0 `sub` claim — the stable external identity key.
  auth0Sub    String    @unique @map("auth0_sub")
  email       String    @unique
  name        String?
  picture     String?
  role        UserRole  @default(VIEWER)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@index([email])
  @@map("users")
}

/// Append-only audit trail. Created in Phase 0 even though only auth events
/// write to it today, so the Workspace build does not need a migration later.
model AuditLog {
  id      String  @id @default(cuid())
  actorId String? @map("actor_id")
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalised Auth0 sub, retained even if the User row is deleted.
  actorSub String? @map("actor_sub")

  /// Dotted verb, e.g. `auth.login`, `contact.submitted`.
  action   String
  /// Entity type the action applies to, e.g. `user`, `contact_submission`.
  entity   String
  entityId String? @map("entity_id")

  metadata  Json?
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum SubmissionType {
  CONTACT
  CREATOR
  CAREERS_WAITLIST
}

enum SubmissionStatus {
  NEW
  IN_REVIEW
  CONTACTED
  ARCHIVED
  SPAM
}

/// Captures the marketing site's contact + waitlist forms.
model ContactSubmission {
  id      String           @id @default(cuid())
  type    SubmissionType   @default(CONTACT)
  status  SubmissionStatus @default(NEW)

  name    String
  email   String
  company String?
  message String?

  /// Route the submission came from, e.g. `/careers`.
  source    String?
  metadata  Json?
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type, status])
  @@index([email])
  @@index([createdAt])
  @@map("contact_submissions")
}
